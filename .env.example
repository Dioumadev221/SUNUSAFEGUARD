# Copier en .env puis adapter. NE JAMAIS committer .env.

# --- Application ---
ENVIRONMENT=development            # development : tables + données de démo créées au démarrage
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Base de données ---
# Local sans Docker : SQLite par défaut (laisser vide). Avec Docker : défini par docker-compose.yml.
# DATABASE_URL=postgresql+psycopg://sunu:sunu_dev_password@localhost:5432/sunusafeguard
POSTGRES_DB=sunusafeguard
POSTGRES_USER=sunu
POSTGRES_PASSWORD=sunu_dev_password

# --- Sécurité (OBLIGATOIRE de changer en production) ---
JWT_SECRET=remplacer-par-une-chaine-aleatoire-de-64-caracteres
JWT_EXPIRE_MINUTES=60
# Clé Fernet : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
DEMO_PASSWORD=SunuDemo2026!

# --- IA ---
# Ollama sert à la fois le LLM et les embeddings. S'il est absent, l'assistant
# reste en service : recherche lexicale et réponses par extraits.
LLM_PROVIDER=ollama                # ollama | none (none = réponses extractives uniquement)
OLLAMA_URL=http://127.0.0.1:11434   # pas « localhost » : ~2 s perdues par requête sous Windows
OLLAMA_MODEL=qwen2.5:3b            # ~2 Go, bon en français ; plus précis : qwen2.5:7b ou llama3.1:8b
OLLAMA_TIMEOUT=120
OLLAMA_AUTO_PULL=true              # télécharge les modèles manquants au démarrage (en arrière-plan)
EMBEDDING_PROVIDER=auto            # auto (Ollama si disponible, sinon lexical) | ollama | hashing
EMBEDDING_MODEL=paraphrase-multilingual
# RAG_MIN_SCORE=0.45               # laisser commenté : seuil calibré automatiquement sur le jeu de tests
RAG_LEXICAL_MIN_SCORE=0.12         # seuil utilisé en recherche lexicale seule
RAG_TOP_K=4

# --- Confidentialité et conservation ---
K_ANONYMITY_THRESHOLD=5
RETENTION_USAGE_DAYS=395
RETENTION_SECURITY_DAYS=180
RETENTION_AUDIT_DAYS=730
RETENTION_REFERRAL_DAYS=365

# --- Protection des API (requêtes / secondes, par IP) ---
RATE_LIMIT_CHAT=30/60
RATE_LIMIT_LOGIN=10/60

# --- Orientations : alerte interne si non reçue après N heures ---
REFERRAL_ALERT_HOURS=24

# --- Monitoring ---
GRAFANA_PASSWORD=change-me
