# Configuration de production. Copier en .env sur le serveur, remplir, ne jamais committer.
# L'API refuse de démarrer si JWT_SECRET, DATA_ENCRYPTION_KEY, la base ou CORS_ORIGINS ne sont pas corrects.

# Nom de domaine public (doit pointer vers l'IP du serveur)
DOMAIN=sunusafeguard.sn
CORS_ORIGINS=https://sunusafeguard.sn

# Base de données (mot de passe long et aléatoire)
POSTGRES_DB=sunusafeguard
POSTGRES_USER=sunu
POSTGRES_PASSWORD=

# Secrets : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# IA : qwen2.5:3b sur 4 vCPU / 8 Go ; qwen2.5:7b recommandé sur 8 vCPU / 16 Go ou GPU
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
OLLAMA_AUTO_PULL=true
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=paraphrase-multilingual
RAG_TOP_K=4

K_ANONYMITY_THRESHOLD=5
RETENTION_USAGE_DAYS=395
RETENTION_SECURITY_DAYS=180
RETENTION_AUDIT_DAYS=730
RETENTION_REFERRAL_DAYS=365
RATE_LIMIT_CHAT=30/60
RATE_LIMIT_LOGIN=10/60
REFERRAL_ALERT_HOURS=24
GRAFANA_PASSWORD=
